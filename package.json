    "node": ">=16"
  },
  "scripts": {
    "doctor": "node scripts/php.mjs doctor",
    "test:info:1": "node scripts/php.mjs test 1",
    "test:info:2": "node scripts/php.mjs test 2",
    "test:info:2b": "node scripts/php.mjs test 2b",
