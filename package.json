    "test:info:4:docker": "docker compose -f info/API/04-order-transaction/compose.yaml run --build --rm test",
    "up:info:example": "docker compose -f info/API/00-example-books-api/compose.yaml up -d --build --wait",
    "up:info:1": "docker compose -f info/API/01-csv-to-sql-api/compose.yaml up -d --build --wait",
    "up:info:2": "docker compose -f info/API/02-create-student-api/compose.yaml up -d --build --wait",
    "up:info:2b": "docker compose -f info/API/02b-get-students-api/compose.yaml up -d --build --wait",
