    "up:info:4": "docker compose -f info/API/04-order-transaction/compose.yaml up -d --build --wait",
    "up:info:sql": "docker compose -f info/sql/fondamenti-sql/compose.yaml up -d --wait",
    "serve:info:example": "node scripts/php.mjs serve example",
    "serve:info:1": "node scripts/php.mjs serve 1",
    "serve:info:2": "node scripts/php.mjs serve 2",
    "serve:info:2b": "node scripts/php.mjs serve 2b",
    "serve:info:2:docker": "node scripts/php.mjs serve-docker 2",
    "serve:info:3": "node scripts/php.mjs serve 3",
    "serve:info:4": "node scripts/php.mjs serve 4"
  }
}
